{
  "name": "satispay-ynab-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "format": "prettier --write src tests package.json tsconfig.json .prettierrc.json",
    "format:check": "prettier --check src tests package.json tsconfig.json .prettierrc.json",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "tsc --noEmit",
    "check:bundle": "wrangler deploy --dry-run --outdir /tmp/satispay-effect-v4-dry-run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261018.1",
    "prettier": "3.9.10",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.1"
  },
  "dependencies": {
    "effect": "^4.0.5",
    "read-excel-file": "^9.3.12"
  }
}
